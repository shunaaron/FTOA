@{
    Layout = null;
}

<link rel="stylesheet" href="~/css/BASE_QYSET.css">

<div class="container-fluid">
    <div id="dynamicQueryContainer" class="dynamic-query-row">
        <!-- JS 會填入查詢欄位 -->
    </div>
</div>

<hr class="mt-4 mb-3">

<!-- 底部按鈕區 (查詢視窗原本的按鈕) -->
<div class="d-flex justify-content-center align-items-center pb-2">
    <button type="button" id="btnConfirm" class="btn btn-success px-4" style="border-radius: 50px;">
        <i class="fas fa-check mr-2"></i> 確認
    </button>
    <button type="button" class="btn btn-secondary px-4 mx-3" style="border-radius: 50px;" data-dismiss="modal">
        <i class="fas fa-times mr-2"></i> 取消
    </button>
</div>

<!-- ========================================== -->
<!-- ★★★ 掃碼專用 Modal (確保結構扁平、唯一) ★★★ -->
<!-- ========================================== -->
<div class="modal fade" id="barcodeScannerModal" tabindex="-1" role="dialog"
     aria-hidden="true" style="z-index: 10000 !important;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="fas fa-qrcode mr-2"></i> 條碼掃描中...</h5>
            </div>
            <div class="modal-body p-0 text-center bg-light">
                <div id="qr-reader" style="width:100%; min-height:300px; background: #000;"></div>

                <div id="scanner-hint" class="p-2 text-primary font-weight-bold" style="font-size: 1.1em;">
                    正在啟動相機...
                </div>

                <!-- ★ 新增：即時掃描結果顯示區 -->
                <div id="scanned-items-list" class="p-2 border-top bg-white" style="max-height: 120px; overflow-y: auto; text-align: left; font-family: monospace;">
                    <div class="text-muted text-center" style="font-size: 0.9em;">尚未掃描任何條碼</div>
                </div>
            </div>
            <div class="modal-footer justify-content-center bg-white">
                <!-- 關閉按鈕：確保沒有 disabled 屬性，且直接調用 hide -->
                <button type="button" id="btnCloseScanner" class="btn btn-dark btn-lg px-5 shadow-sm"
                        style="border-radius: 50px; font-weight: bold; position: relative; z-index: 10001 !important;"
                        onclick="$('#barcodeScannerModal').modal('hide');">
                    <i class="fas fa-times-circle mr-2"></i> 結束掃描
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    #barcodeScannerModal {
        z-index: 10005 !important;
        background-color: transparent !important; /* 強制背景透明，不加深灰色 */
    }

    /* 確保查詢視窗的遮罩在最底下 */
    .modal-backdrop {
        z-index: 1040 !important;
    }

    /* 這一行非常重要：如果 Body 沒了 modal-open，會導致點擊穿透 */
    body.modal-open {
        overflow: hidden !important;
    }

    /* 修正：如果掃碼視窗關閉後出現「看得到點不到」的問題，通常是因為殘留遮罩，這行可以防禦 */
    .modal-backdrop:not(.show) {
        display: none !important;
    }
</style>

<script src="~/js/html5-qrcode.js" type="text/javascript"></script>
<script src="~/js/BASE_QYSET.js" asp-append-version="true"></script>

<script>
    $(document).ready(function () {
        var $modalDialog = $('#dynamicQueryContainer').closest('.modal-dialog');
        if ($modalDialog.length > 0) {
            $modalDialog.addClass('modal-lg');
        }
    });
</script>