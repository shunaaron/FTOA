@model FTOA.Models.ChangePasswordViewModel

@{
    Layout = null; /* ★★★ 關鍵：設為 null 就不會出現 FTOA/Home/Privacy 等導覽列 */
    ViewData["Title"] = "修改密碼";
}

<!DOCTYPE html>
<html lang="zh-tw">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- 必須手動引用 Bootstrap 與 CSS，因為沒有 Layout 了 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/qybase.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/cgpw.css" />
    <!-- 引入 FontAwesome 圖示庫 (如果原本 Layout 有引用的話) -->
    <link rel="stylesheet" href="~/css/all.min.css" />

</head>
<body>

    <div class="container">
        <div class="cgpw-container">
            <div class="form-card">

                <!-- ★★★ 這裡加入圖片 ★★★ -->
                <!-- 請將 src 改為您實際圖片的路徑，例如 ~/images/logo.png -->
                <!-- 這裡暫時使用一個安全盾牌的圖示代替，您可以換成 <img> -->
                <div class="mb-3">
                    <!-- 範例：插入您的圖片 -->
                    <!-- <img src="~/images/your_logo.png" class="security-img" alt="Logo" /> -->
                    <!-- 或者使用大圖示 -->
                    <i class="fas fa-shield-alt text-success" style="font-size: 4rem;"></i>
                </div>
                <div class="form-header text-center">
                    <h3><i class="fas fa-user-shield mr-2"></i>帳號安全</h3>

                    <p class="text-muted small">請定期更換密碼以保護您的帳號</p>

                    <div class="system-desc">
                        <strong>帳密同步更新範圍：</strong>
                        <div class="system-tags-container">
                            <span class="system-tag">
                                <i class="fas fa-mobile-alt"></i> (1) 手持刷件
                            </span>
                            <span class="system-tag">
                                <i class="fas fa-desktop"></i> (2) FTOA 
                            </span>
                        </div>
                    </div>
                </div>

                <form asp-action="Cgpw" method="post">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 mb-3 text-left">
                            <small><i class="fas fa-exclamation-circle mr-1"></i>請修正錯誤：</small>
                            <div asp-validation-summary="All" class="small mt-1 m-0 p-0"></div>
                        </div>
                    }

                    @if (TempData["SuccessMsg"] != null)
                    {
                        <div class="alert alert-success py-2 mb-3">
                            <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMsg"]
                        </div>
                    }

                    <div class="form-group">
                        <label asp-for="OldPassword">目前密碼</label>
                        <input asp-for="OldPassword" class="form-control" type="password" placeholder="請輸入目前的密碼" />
                        <span asp-validation-for="OldPassword" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="NewPassword">新密碼</label>
                        <input asp-for="NewPassword" class="form-control" type="password" placeholder="建議 6 位數以上" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="ConfirmPassword">確認新密碼</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="再次輸入新密碼" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <!-- ★★★ 只保留儲存按鈕，並設為全寬 ★★★ -->
                    <button type="submit" class="btn btn-success btn-submit shadow-sm">
                        <i class="fas fa-save mr-2"></i>儲存變更
                    </button>

                </form>
            </div>
        </div>
    </div>

    <!-- 腳本引用 (因為沒有 Layout，需手動加入) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

</body>
</html>